# --- Discord OAuth (create an app at https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=1553085736515796992
# Server-side only. NEVER expose this to the frontend or commit it.
DISCORD_CLIENT_SECRET=
# Must exactly match a Redirect URI configured on the Discord app, and
# point at THIS server (not the frontend): e.g.
# https://your-realtime-server.example.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# --- Optional: restrict access to members of one Discord server ---
# Leave unset to disable guild-membership verification entirely (every
# authenticated Discord user is allowed in). Never hardcode a guild ID
# in source — only ever read from this env var.
DISCORD_GUILD_ID=

# --- Frontend origin, for CORS + post-login redirect target ---
FRONTEND_URL=http://localhost:5173

# --- Server ---
PORT=8080
NODE_ENV=development
